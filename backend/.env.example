# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/civix

# Server port
PORT=5000

# Comma separated list of allowed origins for CORS
CLIENT_ORIGIN=http://localhost:5173

# Optional: Groq API key for real LLM-powered analysis.
# Get a free key at https://console.groq.com
# If left empty, Civi-X automatically falls back to a robust
# rule-based AI simulation so the demo always works offline.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
